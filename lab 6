def merge_sort(a):
    if len(a) > 1:
        m = len(a) // 2
        l = a[:m]
        r = a[m:]
        merge_sort(l)
        merge_sort(r)
        i = j = k = 0
        while i < len(l) and j < len(r):
            if l[i] < r[j]:
                a[k] = l[i]; i += 1
            else:
                a[k] = r[j]; j += 1
            k += 1
        a[k:] = l[i:] + r[j:]

a = [38, 27, 43, 3, 9, 82, 10]
merge_sort(a)
print(a)
